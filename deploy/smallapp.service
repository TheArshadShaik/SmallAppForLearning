[Unit]
Description=SmallApp Modular Python Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/smallapp
Environment="PATH=/opt/smallapp/venv/bin"
Environment="FLASK_ENV=production"
Environment="PORT=5000"
Environment="ENABLE_FEATURE_1=true"
Environment="ENABLE_FEATURE_2=true"
ExecStart=/opt/smallapp/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
